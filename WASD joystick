--==================================================
-- VARIABLES
--==================================================

local activeTouch = nil
local dragging = false
local moveVector = Vector2.zero

--==================================================
-- GET JOYSTICK CENTER
--==================================================

local function getCenter()
	return base.AbsolutePosition + base.AbsoluteSize / 2
end

--==================================================
-- UPDATE JOYSTICK
--==================================================

local function updateJoystick(position)

	local center = getCenter()

	-- Actual distance from joystick center
	local offset = Vector2.new(position.X, position.Y) - center

	local maxDistance =
		(base.AbsoluteSize.X - thumb.AbsoluteSize.X) / 2

	-- Movement direction is limited to the joystick's range
	local movementOffset = offset

	if movementOffset.Magnitude > maxDistance then
		movementOffset = movementOffset.Unit * maxDistance
	end

	--==============================================
	-- WHITE THUMB FOLLOWS ACTUAL FINGER
	--==============================================

	thumb.Position = UDim2.fromOffset(
		position.X,
		position.Y
	)

	--==============================================
	-- WHITE LINE
	--==============================================

	local distance = offset.Magnitude

	if distance > 1 then

		line.Visible = true

		line.Position = UDim2.fromOffset(
			center.X,
			center.Y
		)

		line.Size = UDim2.fromOffset(
			distance,
			6
		)

		line.Rotation = math.deg(
			math.atan2(offset.Y, offset.X)
		)

	else
		line.Visible = false
	end

	--==============================================
	-- MOVEMENT VECTOR
	--==============================================

	if offset.Magnitude > 0 then

		local normalized = offset.Unit

		moveVector = Vector2.new(
			normalized.X *
				math.min(offset.Magnitude / maxDistance, 1),

			-normalized.Y *
				math.min(offset.Magnitude / maxDistance, 1)
		)

	else
		moveVector = Vector2.zero
	end
end

--==================================================
-- RELEASE
--==================================================

local function releaseJoystick()

	activeTouch = nil
	dragging = false
	moveVector = Vector2.zero

	thumb.Position = UDim2.fromOffset(
		getCenter().X,
		getCenter().Y
	)

	line.Visible = false
end

--==================================================
-- START TOUCH
--==================================================

base.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.Touch then

		-- Ignore additional fingers
		if activeTouch ~= nil then
			return
		end

		activeTouch = input
		dragging = true

		updateJoystick(input.Position)

	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then

		if activeTouch ~= nil then
			return
		end

		activeTouch = input
		dragging = true

		updateJoystick(input.Position)
	end
end)

--==================================================
-- TRACK ORIGINAL TOUCH ANYWHERE
--==================================================

UserInputService.TouchMoved:Connect(function(input)

	if input == activeTouch then
		updateJoystick(input.Position)
	end
end)

--==================================================
-- RELEASE ORIGINAL TOUCH
--==================================================

UserInputService.InputEnded:Connect(function(input)

	if input == activeTouch then
		releaseJoystick()
	end
end)

